# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values. Never commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by the API and the worker.
DATABASE_URL="postgresql://statuspage:statuspage@localhost:5432/statuspage?schema=public"

# API
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"
# Comma separated list of allowed browser origins. Only needed in development,
# in production the web container serves the API on the same origin.
CORS_ORIGIN="http://localhost:5173"
# Long random string, at least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime in days.
SESSION_TTL_DAYS="7"
# Set to true when the API is served over HTTPS (cookies get the Secure flag).
COOKIE_SECURE="false"

# Admin account. Created on first start and re-synced on every API start.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Monitoring
# Consecutive failed checks before an automatic incident is created.
MONITOR_FAILURE_THRESHOLD="3"
# Consecutive successful checks before the service counts as recovered.
MONITOR_RECOVERY_THRESHOLD="3"
# Response time in ms above which a successful service is marked as degraded.
# Use 0 to disable slow-response detection.
MONITOR_DEGRADED_RESPONSE_TIME_MS="2000"
# Default check interval (seconds) and timeout (ms) for new services.
MONITOR_DEFAULT_CHECK_INTERVAL="60"
MONITOR_DEFAULT_TIMEOUT="10000"
# Monitoring history retention in days. Uptime periods longer than this are
# partially filled with "no data".
MONITOR_RETENTION_DAYS="90"
# How often the worker looks for services that are due for a check (ms).
WORKER_TICK_MS="5000"

# Discord webhook. Leave empty to disable Discord notifications.
DISCORD_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# Docker Compose only (optional, defaults shown)
# ---------------------------------------------------------------------------
POSTGRES_USER="statuspage"
POSTGRES_PASSWORD="statuspage"
POSTGRES_DB="statuspage"
API_PORT="3000"
WEB_PORT="8080"
